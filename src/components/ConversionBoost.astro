---
import { ACQUISITION_MAILTO, SITE } from '../config/site';
---

<!-- Sticky mobile buy bar (CRO): visible on small screens after scrolling past hero -->
<div id="sticky-cta" class="fixed bottom-0 inset-x-0 z-40 md:hidden translate-y-full transition-transform duration-300" aria-hidden="false">
  <div class="mx-3 mb-3 rounded-2xl border border-white/10 bg-[#0a0a0f]/95 p-3 flex items-center gap-3" style="backdrop-filter: blur(20px);">
    <div class="flex-1 min-w-0">
      <div class="text-sm font-semibold truncate">{SITE.name}</div>
      <div class="text-xs text-emerald-300 font-medium">{SITE.priceDisplay} USD · Escrow protected</div>
    </div>
    <a href={ACQUISITION_MAILTO} data-cta="buy-now-sticky"
       class="inline-flex items-center justify-center px-5 py-3 min-h-[48px] min-w-[48px] rounded-xl bg-white text-[#0a0a0f] text-sm font-semibold">
      Buy Now
    </a>
    <a href="#inquire" data-cta="offer-sticky"
       class="inline-flex items-center justify-center px-5 py-3 min-h-[48px] min-w-[48px] rounded-xl border border-white/20 text-sm font-medium">
      Offer
    </a>
  </div>
</div>

<!-- Exit-intent lead capture (CRO): email capture / special terms, once per session -->
<div id="exit-intent" class="hidden fixed inset-0 z-50 items-center justify-center p-6" role="dialog" aria-modal="true" aria-labelledby="exit-heading">
  <div class="absolute inset-0 bg-black/70" data-exit-close aria-hidden="true"></div>
  <div class="relative glass rounded-3xl border border-white/10 p-8 max-w-md w-full text-center">
    <button data-exit-close class="absolute top-4 right-4 w-11 h-11 inline-flex items-center justify-center rounded-full border border-white/15 text-white/60 hover:text-white" aria-label="Close offer">
      <span aria-hidden="true" class="text-xl leading-none">×</span>
    </button>
    <div class="inline-block px-3 py-1 rounded-full bg-emerald-400/10 text-emerald-300 text-xs tracking-[1.5px] font-semibold mb-4">BEFORE YOU GO</div>
    <h2 id="exit-heading" class="text-2xl font-semibold tracking-tight mb-2">Get flexible terms on this domain</h2>
    <p class="text-white/70 text-sm mb-6">Leave your email and we'll send payment-plan options plus a 48-hour hold on serious offers — no spam, confidential.</p>
    <form id="exit-form" class="space-y-3" action={ACQUISITION_MAILTO} method="get">
      <label for="exit-email" class="sr-only">Email address</label>
      <input id="exit-email" name="body" type="email" required placeholder="you@company.com"
             class="form-input w-full bg-white/5 border border-white/15 rounded-2xl px-5 py-3.5 min-h-[48px] text-white placeholder:text-white/40 focus:border-brand-500/60" />
      <button type="submit" class="w-full py-3.5 min-h-[48px] rounded-2xl bg-gradient-to-r from-brand-500 to-accent-500 font-semibold text-[#0a0a0f] hover:brightness-105 transition-all">
        Send Me Terms
      </button>
    </form>
    <p class="mt-3 text-[11px] text-white/40">Escrow-protected · Response within 24 hours</p>
  </div>
</div>

<script>
  // Sticky bar: show after scrolling past ~70vh
  const bar = document.getElementById('sticky-cta');
  const toggle = () => {
    if (!bar) return;
    const show = window.scrollY > window.innerHeight * 0.7;
    bar.classList.toggle('translate-y-full', !show);
  };
  window.addEventListener('scroll', toggle, { passive: true });
  toggle();

  // Exit intent: desktop mouseleave-to-top OR mobile idle 45s; once per session
  const modal = document.getElementById('exit-intent');
  let shown = false;
  try { shown = sessionStorage.getItem('exit-shown') === '1'; } catch { shown = false; }
  const open = () => {
    if (shown || !modal) return;
    shown = true;
    try { sessionStorage.setItem('exit-shown', '1'); } catch {}
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  };
  const close = () => {
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  };
  document.addEventListener('mouseout', (e) => {
    if (!e.relatedTarget && e.clientY <= 8) open();
  });
  setTimeout(() => { if (!shown && window.scrollY < 200) open(); }, 45000);
  modal?.querySelectorAll('[data-exit-close]').forEach((b) => b.addEventListener('click', close));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  document.getElementById('exit-form')?.addEventListener('submit', () => {
    try { console.log('[cro] exit-intent lead captured'); } catch {}
    close();
  });

  // Lightweight CTA click tracking hook (works with any analytics: data-cta attributes)
  document.querySelectorAll('[data-cta]').forEach((a) => {
    a.addEventListener('click', () => {
      try { console.log('[cta]', a.getAttribute('data-cta')); } catch {}
    });
  });
</script>
