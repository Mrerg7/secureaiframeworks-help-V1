---
import { ACQUISITION_MAILTO, SITE } from '../config/site';
---

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 border-b border-white/5">
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <div class="flex items-center gap-x-3">
        <div class="w-9 h-9 rounded-2xl bg-gradient-to-br from-brand-500 via-accent-500 to-brand-500 p-px">
          <div class="w-full h-full bg-[#0a0a0f] rounded-2xl flex items-center justify-center">
            <span class="text-brand-500 text-lg font-bold tracking-tighter">SAF</span>
          </div>
        </div>
        <div>
          <div class="font-display text-2xl font-semibold tracking-tighter">{SITE.name}</div>
        </div>
      </div>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-x-9 text-sm font-medium">
        <a href="#positioning" class="text-white/80 hover:text-white transition-colors">The Opportunity</a>
        <a href="#why" class="text-white/80 hover:text-white transition-colors">Why This Domain</a>
        <a href="#uses" class="text-white/80 hover:text-white transition-colors">Ideal For</a>
        <a href="#pricing" class="text-white/80 hover:text-white transition-colors">Pricing</a>
        <a href="#faq" class="text-white/80 hover:text-white transition-colors">FAQ</a>
      </div>

      <!-- CTA Buttons -->
      <div class="flex items-center gap-x-3">
        <a href="#inquire"
           class="hidden sm:inline-flex items-center justify-center px-6 py-2.5 min-h-[48px] text-sm font-semibold rounded-2xl border border-white/20 hover:bg-white/5 transition-colors">
          Make Offer
        </a>
        <a href={ACQUISITION_MAILTO}
           data-cta="buy-now-nav"
           class="inline-flex items-center justify-center px-6 py-2.5 min-h-[48px] text-sm font-semibold rounded-2xl bg-white text-[#0a0a0f] hover:bg-white/90 transition-all active:scale-[0.985]">
          Buy Now
        </a>

        <!-- Mobile Menu Button -->
        <button id="mobile-menu-btn"
                class="md:hidden w-12 h-12 min-w-[48px] min-h-[48px] flex items-center justify-center text-white/70 hover:text-white transition-colors"
                aria-label="Toggle menu"
                aria-expanded="false"
                aria-controls="mobile-menu">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</nav>

<!-- Mobile Menu -->
<div id="mobile-menu" class="hidden md:hidden fixed inset-0 z-40 bg-[#0a0a0f] pt-20">
  <div class="px-6 py-8 flex flex-col gap-y-2 text-lg font-medium">
    <a href="#positioning" class="py-3 min-h-[48px] inline-flex items-center">The Opportunity</a>
    <a href="#why" class="py-3 min-h-[48px] inline-flex items-center">Why This Domain</a>
    <a href="#uses" class="py-3 min-h-[48px] inline-flex items-center">Ideal For</a>
    <a href="#pricing" class="py-3 min-h-[48px] inline-flex items-center">Pricing</a>
    <a href="#faq" class="py-3 min-h-[48px] inline-flex items-center">FAQ</a>
    <div class="pt-4 border-t border-white/10 space-y-3">
      <a href={ACQUISITION_MAILTO} class="block w-full text-center py-4 min-h-[48px] rounded-2xl bg-white text-[#0a0a0f] font-semibold">Buy Now — $11,997</a>
      <a href="#inquire" class="block w-full text-center py-4 min-h-[48px] rounded-2xl border border-white/20 font-medium">Make Offer</a>
    </div>
  </div>
</div>
